# Reproducible *candidate* backend image. No automatic deployment or paid inference.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    AUREX_DB_PATH=/data/aurex_jobs.db \
    AUREX_ENABLE_OFFLINE_LAB=0 \
    AUREX_ENABLE_SYNTHETIC_FIELD_AUDIT=0
WORKDIR /app
COPY pyproject.toml README.md ./
COPY aurex ./aurex
COPY integrations ./integrations
COPY workstation ./workstation
COPY training ./training
RUN python -m pip install --no-cache-dir . && \
    useradd --create-home --uid 10001 aurex && \
    mkdir -p /data && chown -R aurex:aurex /data
USER aurex
EXPOSE 8080
CMD ["sh","-c","exec uvicorn aurex.api:app --host 0.0.0.0 --port ${PORT:-8080} --no-access-log"]
